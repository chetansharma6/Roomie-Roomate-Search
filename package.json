{
  "name": "roomie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "smoke:gemini": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-gemini.ts",
    "supabase:serve": "npx supabase functions serve roommate-insights --env-file supabase/functions/.env",
    "supabase:deploy": "npx supabase functions deploy roommate-insights --use-api"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.81.1",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/node": "^5.10.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.0"
  }
}
