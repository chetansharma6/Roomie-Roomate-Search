# Browser-safe Supabase configuration. Copy this file to .env.local and fill it in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only configuration. Never prefix secrets with VITE_.
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Gemini matching (server-only; get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Local demo mode with fictional data and no sign-in. Ignored on Vercel production.
ROOMIE_DEMO_MODE=true
