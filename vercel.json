{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/match.ts": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/discover", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/matches", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" }
  ]
}
